# Copy to .env for `vercel dev`. Never commit the real .env.
# These must also be set in Vercel Dashboard → Project → Settings → Environment Variables.

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# From https://console.cloud.google.com — enable "YouTube Data API v3"
YOUTUBE_API_KEY=AIza...

# ── Gemini (free tier: 1500 requests/day) ────────────────────────────────────
# From https://aistudio.google.com/app/apikey — takes 30 seconds, no billing
GEMINI_API_KEY=AIza...

# ── Postgres ─────────────────────────────────────────────────────────────────
# Vercel Postgres, Neon, Supabase, Railway — any postgres connection string
DB_URL=postgres://user:password@host:5432/dbname

# ── Resend (email) ───────────────────────────────────────────────────────────
# From https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be on your verified Resend domain
FROM_EMAIL="Wavecrest Pro <hello@wavecrest.pro>"
# Where new-signup alerts go
NOTIFY_EMAIL=your@email.com

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=https://wavecrest.pro
