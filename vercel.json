{
  "version": 2,
  "builds": [
    { "src": "server/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/index.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/index.html", "dest": "/public/index.html" },
    { "src": "/checkout-free.html", "dest": "/public/checkout-free.html" },
    { "src": "/checkout-plus.html", "dest": "/public/checkout-plus.html" },
    { "src": "/checkout-pro.html", "dest": "/public/checkout-pro.html" },
    { "src": "/checkout-max.html", "dest": "/public/checkout-max.html" },
    { "src": "/checkout-teams.html", "dest": "/public/checkout-teams.html" },
    { "src": "/checkout-enterprise.html", "dest": "/public/checkout-enterprise.html" },
    { "src": "/dashboard.html", "dest": "/public/dashboard.html" },
    { "src": "/signin.html", "dest": "/public/signin.html" },
    { "src": "/signup.html", "dest": "/public/signup.html" },
    { "src": "/analytics.html", "dest": "/public/analytics.html" },
    { "src": "/api-docs.html", "dest": "/public/api-docs.html" },
    { "src": "/api-docs.json", "dest": "/public/api-docs.json" },
    { "src": "/trends.json", "dest": "/public/trends.json" }
  ]
}
